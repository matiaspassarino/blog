---
// Error de servidor (research D13): por ejemplo, la base no responde y la página nunca se
// generó. No muestra datos técnicos. El CDN no cachea 5xx.
import Base from '../layouts/Base.astro';
import Boton from '../components/ui/Boton.astro';
import Contenedor from '../components/ui/Contenedor.astro';
---

<Base
  titulo="Tuvimos un problema"
  descripcion="No pudimos mostrar esta página en este momento. Probá de nuevo en unos minutos o volvé a la portada del sitio."
  ruta="/500"
  noindex
>
  <Contenedor ancho="lectura" class="py-seccion text-center">
    <p class="font-titulos text-sm font-semibold tracking-wide text-marca uppercase">Error 500</p>
    <h1 class="mt-3 font-titulos text-titulo-1 font-bold text-balance">Tuvimos un problema</h1>
    <p class="mt-4 text-lg text-texto-suave">No pudimos mostrar esta página. Probá de nuevo en unos minutos.</p>
    <div class="mt-8 flex justify-center">
      <Boton href="/">Ir a la portada</Boton>
    </div>
  </Contenedor>
</Base>
