---
// Autor (H2-E4, RF-011): nombre, foto, biografía y sus publicados. El slug es inmutable: no
// hay redirecciones. Nunca se muestran correo, rol ni estado (la vista no los expone).
import { listarPorAutor } from '@blog/db';
import AvatarAutor from '../../../../components/AvatarAutor.astro';
import ListadoArticulos from '../../../../components/ListadoArticulos.astro';
import Base from '../../../../layouts/Base.astro';
import { landing } from '../../../../contenido/landing';
import { cacheListado } from '../../../../lib/cache';
import { datos } from '../../../../lib/datos';
import { resolverListado, rutaDePagina } from '../../../../lib/listados';

const slug = Astro.params.slug ?? '';
const rutaBase = `/blog/autor/${slug}`;
const resultado = await resolverListado({
  param: Astro.params.pagina,
  rutaBase,
  cargar: (pagina) => listarPorAutor(datos, slug, { pagina }),
});
if (resultado.tipo === 'respuesta') {
  Astro.cache.set(resultado.cache);
  return resultado.respuesta;
}

const { autor, articulos } = resultado.valor;
Astro.cache.set(cacheListado({ tipo: 'autor', id: autor.id }));

const sufijo = resultado.pagina > 1 ? ` — página ${resultado.pagina}` : '';
const descripcion = autor.biografia ?? `Artículos de ${autor.nombre} en el blog de ${landing.sitio.nombre}.`;
---

<Base
  titulo={`${autor.nombre}${sufijo}`}
  descripcion={descripcion}
  ruta={rutaDePagina(rutaBase, resultado.pagina)}
  tipo="profile"
>
  <ListadoArticulos articulos={articulos} rutaBase={rutaBase}>
    <div slot="encabezado" class="flex items-center gap-5">
      <AvatarAutor autor={autor} tamanio={64} />
      <div>
        <p class="font-titulos text-sm font-semibold tracking-wide text-marca uppercase">Autor</p>
        <h1 class="mt-1 font-titulos text-titulo-1 font-bold">{autor.nombre}{sufijo}</h1>
      </div>
    </div>
    {autor.biografia && <p slot="encabezado" class="mt-4 text-lg text-texto-suave">{autor.biografia}</p>}
  </ListadoArticulos>
</Base>
