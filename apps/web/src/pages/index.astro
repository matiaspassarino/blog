---
// Portada de la demo (H3, RF-012): seis secciones en orden. Textos en contenido/landing.ts e
// identidad en packages/ui (§VII.6).
import { listarArticulosPublicados } from '@blog/db';
import Contacto from '../components/landing/Contacto.astro';
import Hero from '../components/landing/Hero.astro';
import Propuesta from '../components/landing/Propuesta.astro';
import Servicios from '../components/landing/Servicios.astro';
import Testimonios from '../components/landing/Testimonios.astro';
import UltimosArticulos from '../components/landing/UltimosArticulos.astro';
import { landing } from '../contenido/landing';
import Base from '../layouts/Base.astro';
import { cacheListado } from '../lib/cache';
import { datos } from '../lib/datos';

const ultimos = await listarArticulosPublicados(datos, { porPagina: 3 });
Astro.cache.set(cacheListado());
---

<Base titulo={landing.sitio.lema} descripcion={landing.sitio.descripcion} ruta="/">
  <Hero />
  <Propuesta />
  <Servicios />
  <Testimonios />
  <UltimosArticulos articulos={ultimos.items} />
  <Contacto />
</Base>
