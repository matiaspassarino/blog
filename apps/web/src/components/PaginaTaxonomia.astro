---
// Página de categoría o etiqueta (H2-E2, H2-E3, RSEO-009): vacía → estado vacío y noindex.
import { landing } from '../contenido/landing';
import Base from '../layouts/Base.astro';
import { coleccion, migas } from '../lib/json-ld';
import { rutaDePagina } from '../lib/listados';
import { sitio } from '../lib/sitio';
import type { ListadoTaxonomia } from '../lib/taxonomias';
import ListadoArticulos from './ListadoArticulos.astro';

type Props = ListadoTaxonomia;

const { valor, pagina, rutaBase, tipoTaxonomia } = Astro.props;
const { entidad, articulos } = valor;
const sufijo = pagina > 1 ? ` — página ${pagina}` : '';
const descripcion =
  entidad.descripcion ??
  `Artículos sobre ${entidad.nombre} en el blog de ${landing.sitio.nombre}: guías, consejos y novedades.`;
const ruta = rutaDePagina(rutaBase, pagina);
const jsonLd = [
  coleccion({ nombre: `${entidad.nombre}${sufijo}`, descripcion, ruta }, sitio.url),
  migas(
    [
      { nombre: 'Inicio', ruta: '/' },
      { nombre: 'Blog', ruta: '/blog' },
      { nombre: entidad.nombre, ruta: rutaBase },
    ],
    sitio.url,
  ),
];
---

<Base
  titulo={`${entidad.nombre}${sufijo}`}
  descripcion={descripcion}
  ruta={ruta}
  noindex={articulos.total === 0}
  jsonLd={jsonLd}
>
  <ListadoArticulos articulos={articulos} rutaBase={rutaBase}>
    <Fragment slot="encabezado">
      <p class="font-titulos text-sm font-semibold tracking-wide text-marca uppercase">
        {tipoTaxonomia === 'categoria' ? 'Categoría' : 'Etiqueta'}
      </p>
      <h1 class="mt-2 font-titulos text-titulo-1 font-bold">{entidad.nombre}{sufijo}</h1>
      {entidad.descripcion && <p class="mt-3 text-lg text-texto-suave">{entidad.descripcion}</p>}
    </Fragment>
  </ListadoArticulos>
</Base>
