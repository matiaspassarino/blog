---
// Tarjeta única de artículo (RF-009): portada, listados y relacionados. Un solo enlace, en el
// título, que se extiende a toda la tarjeta.
import type { ResumenArticulo } from '@blog/db';
import { Image } from 'astro:assets';
import { PUBLIC_SUPABASE_URL } from 'astro:env/server';
import { fechaLarga } from '../lib/fechas';
import { urlImagen } from '../lib/imagenes';

interface Props {
  articulo: ResumenArticulo;
  /** Nivel del título según la página (sin saltos de encabezado, RSEO-008). */
  nivel?: 2 | 3;
  /** La primera tarjeta de un listado es el LCP: carga sin diferir (RF-026, T099). */
  prioridad?: boolean;
}

const { articulo, nivel = 2, prioridad = false } = Astro.props;
const Titulo = `h${nivel}` as const;
const imagen = articulo.imagen_destacada;
const SIZES = '(min-width: 1024px) 23rem, (min-width: 640px) 50vw, 100vw';
---

<article
  class="group relative flex flex-col overflow-hidden rounded-lg border border-separador bg-fondo shadow-tarjeta transition-shadow duration-(--duracion-corta) ease-estandar focus-within:ring-3 focus-within:ring-foco hover:shadow-lg"
>
  {
    imagen ? (
      <Image
        src={urlImagen(imagen.ruta, PUBLIC_SUPABASE_URL)}
        alt=""
        width={imagen.ancho}
        height={imagen.alto}
        widths={[400, 800]}
        sizes={SIZES}
        loading={prioridad ? 'eager' : 'lazy'}
        fetchpriority={prioridad ? 'high' : undefined}
        class="aspect-tarjeta w-full bg-superficie object-cover"
      />
    ) : (
      <img
        src="/imagen-generica.svg"
        alt=""
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
        class="aspect-tarjeta w-full bg-superficie object-cover"
      />
    )
  }
  <div class="flex flex-1 flex-col gap-3 p-5">
    {articulo.categoria && <p class="text-sm font-semibold text-marca">{articulo.categoria.nombre}</p>}
    <Titulo class="font-titulos text-xl leading-snug font-bold">
      <a
        href={`/blog/${articulo.slug}`}
        class="line-clamp-3 break-words after:absolute after:inset-0 group-hover:underline focus-visible:outline-none"
      >
        {articulo.titulo}
      </a>
    </Titulo>
    {articulo.extracto && <p class="line-clamp-3 text-texto-suave">{articulo.extracto}</p>}
    <time datetime={articulo.publicado_en} class="mt-auto text-sm text-texto-suave">
      {fechaLarga(articulo.publicado_en)}
    </time>
  </div>
</article>
