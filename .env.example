# Copiar a .env.local (raíz, apps/web y apps/admin según corresponda). Valores locales: `supabase status`.
PUBLIC_URL_SITIO=http://localhost:4321
PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (apps/admin). Nunca en apps/web ni en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Firma HMAC de los avisos de la base a /api/revalidar (≥ 32 caracteres)
SECRETO_REVALIDACION=secreto-local-de-desarrollo-no-usar-en-produccion
URL_WEB_REVALIDACION=http://localhost:4321
